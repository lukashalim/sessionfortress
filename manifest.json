{
  "manifest_version": 3,
  "name": "Session Fortress",
  "version": "0.1.9",
  "description": "Save windows and Tab Groups. Mirror every save to a folder you control so Chrome crashes cannot wipe you.",
  "minimum_chrome_version": "120",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Session Fortress",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "tabs",
    "tabGroups",
    "windows",
    "storage",
    "unlimitedStorage",
    "alarms",
    "offscreen",
    "commands"
  ],
  "commands": {
    "save-window": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this window"
    },
    "save-all": {
      "description": "Save all windows"
    },
    "stash": {
      "description": "Save and close this window"
    },
    "open-manager": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open session manager"
    }
  }
}
